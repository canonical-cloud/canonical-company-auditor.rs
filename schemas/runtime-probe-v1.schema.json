{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical.plus/schemas/runtime-probe-v1.schema.json",
  "title": "Canonical runtime exposure probe output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtime", "probeVersion", "target", "facts", "fingerprints", "limitations"],
  "properties": {
    "schemaVersion": { "const": "canonical.runtime-probe/v1" },
    "runtime": { "enum": ["python", "typescript"] },
    "probeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "target": { "type": "string", "minLength": 1, "maxLength": 512 },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suspected_secret_count", "scanned_binding_count", "truncated"],
      "properties": {
        "suspected_secret_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "scanned_binding_count": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "truncated": { "type": "boolean" }
      }
    },
    "fingerprints": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "locationSha256", "valueSha256", "valueType"],
        "properties": {
          "category": { "enum": ["sensitive_binding_name", "secret_like_value"] },
          "locationSha256": { "$ref": "#/$defs/digest" },
          "valueSha256": {
            "oneOf": [
              { "$ref": "#/$defs/digest" },
              { "type": "null" }
            ]
          },
          "valueType": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
