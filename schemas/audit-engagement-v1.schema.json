{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical-cloud.dev/schemas/audit-engagement-v1.schema.json",
  "title": "Canonical audit engagement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engagementId",
    "tenantId",
    "scopeId",
    "title",
    "mode",
    "phase",
    "period",
    "frameworkIds",
    "objective",
    "criteria",
    "actors"
  ],
  "properties": {
    "schemaVersion": { "const": "canonical.audit-engagement/v1" },
    "engagementId": { "$ref": "#/$defs/identifier" },
    "tenantId": { "$ref": "#/$defs/identifier" },
    "scopeId": { "$ref": "#/$defs/scope" },
    "title": { "$ref": "#/$defs/text" },
    "mode": { "enum": ["dress_rehearsal", "full_audit"] },
    "phase": {
      "enum": ["planning", "fieldwork", "review", "management_response", "finalized"]
    },
    "period": { "$ref": "#/$defs/period" },
    "frameworkIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "objective": { "$ref": "#/$defs/longText" },
    "criteria": { "$ref": "#/$defs/longText" },
    "actors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/actor" }
    },
    "milestones": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/milestone" }
    },
    "evidenceRequests": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/evidenceRequest" }
    },
    "samplePlans": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/samplePlan" }
    },
    "workpapers": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/workpaper" }
    },
    "managementResponses": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/managementResponse" }
    },
    "events": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/event" }
    },
    "reportRecipients": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:@-]+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_.:@-]+(?:/[A-Za-z0-9_.:@-]+)*$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "longText": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "integer", "minimum": 0 },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startsAt", "endsAt"],
      "properties": {
        "startsAt": { "$ref": "#/$defs/timestamp" },
        "endsAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "role", "organization", "displayName", "independent"],
      "properties": {
        "actorId": { "$ref": "#/$defs/identifier" },
        "role": {
          "enum": ["audit_lead", "auditor", "reviewer", "control_owner", "evidence_owner", "executive"]
        },
        "organization": { "$ref": "#/$defs/text" },
        "displayName": { "$ref": "#/$defs/text" },
        "independent": { "type": "boolean" }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["milestoneId", "title", "dueAt"],
      "properties": {
        "milestoneId": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/text" },
        "dueAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "evidenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "title", "ruleIds", "ownerId", "dueAt", "status"],
      "properties": {
        "requestId": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/text" },
        "ruleIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "ownerId": { "$ref": "#/$defs/identifier" },
        "dueAt": { "$ref": "#/$defs/timestamp" },
        "status": { "enum": ["open", "submitted", "accepted", "rejected", "closed"] },
        "evidenceExternalIds": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "auditorNote": { "type": "string", "maxLength": 4000 }
      }
    },
    "samplePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samplePlanId",
        "ruleId",
        "populationId",
        "populationSize",
        "method",
        "sampleSize",
        "selectedItemFingerprints",
        "rationale"
      ],
      "properties": {
        "samplePlanId": { "$ref": "#/$defs/identifier" },
        "ruleId": { "$ref": "#/$defs/identifier" },
        "populationId": { "$ref": "#/$defs/identifier" },
        "populationSize": { "type": "integer", "minimum": 1 },
        "method": { "enum": ["full_population", "random", "systematic", "judgmental"] },
        "sampleSize": { "type": "integer", "minimum": 1 },
        "selectedItemFingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "rationale": { "$ref": "#/$defs/longText" }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exceptionId", "classification", "title", "description", "disposition"],
      "properties": {
        "exceptionId": { "$ref": "#/$defs/identifier" },
        "classification": { "enum": ["observation", "minor", "major"] },
        "title": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/longText" },
        "evidenceExternalIds": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "disposition": { "enum": ["open", "remediated", "risk_accepted", "compensating_control"] }
      }
    },
    "reviewSignoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewerId", "reviewedAt", "conclusion"],
      "properties": {
        "reviewerId": { "$ref": "#/$defs/identifier" },
        "reviewedAt": { "$ref": "#/$defs/timestamp" },
        "conclusion": { "enum": ["approved", "changes_requested"] },
        "note": { "type": "string", "maxLength": 4000 }
      }
    },
    "workpaper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workpaperId",
        "ruleId",
        "preparerId",
        "preparedAt",
        "procedurePerformed",
        "designConclusion",
        "operatingConclusion"
      ],
      "properties": {
        "workpaperId": { "$ref": "#/$defs/identifier" },
        "ruleId": { "$ref": "#/$defs/identifier" },
        "preparerId": { "$ref": "#/$defs/identifier" },
        "preparedAt": { "$ref": "#/$defs/timestamp" },
        "procedurePerformed": { "$ref": "#/$defs/longText" },
        "designConclusion": { "enum": ["effective", "ineffective", "not_tested", "not_applicable"] },
        "operatingConclusion": { "enum": ["effective", "ineffective", "not_tested", "not_applicable"] },
        "evidenceExternalIds": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "samplePlanId": { "$ref": "#/$defs/identifier" },
        "exceptions": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/exception" }
        },
        "reviewerSignoff": { "$ref": "#/$defs/reviewSignoff" }
      }
    },
    "managementResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responseId", "exceptionId", "ownerId", "response", "actionPlan", "dueAt", "status"],
      "properties": {
        "responseId": { "$ref": "#/$defs/identifier" },
        "exceptionId": { "$ref": "#/$defs/identifier" },
        "ownerId": { "$ref": "#/$defs/identifier" },
        "response": { "$ref": "#/$defs/longText" },
        "actionPlan": { "$ref": "#/$defs/longText" },
        "dueAt": { "$ref": "#/$defs/timestamp" },
        "status": { "enum": ["planned", "in_progress", "complete", "risk_accepted"] }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "eventType", "actorId", "occurredAt", "subjectId", "payloadSha256"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "eventType": { "$ref": "#/$defs/identifier" },
        "actorId": { "$ref": "#/$defs/identifier" },
        "occurredAt": { "$ref": "#/$defs/timestamp" },
        "subjectId": { "$ref": "#/$defs/identifier" },
        "payloadSha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
