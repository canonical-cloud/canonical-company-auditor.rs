{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical-cloud.dev/schemas/audit-package-v1.schema.json",
  "title": "Canonical audit package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "documents"],
  "properties": {
    "manifest": { "$ref": "#/$defs/manifest" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "mediaType", "sha256", "bytes"],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "mediaType": { "enum": ["text/markdown", "application/json"] },
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 10485760 }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "mediaType", "sha256", "bytes", "content"],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "mediaType": { "enum": ["text/markdown", "application/json"] },
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 10485760 },
        "content": { "type": "string", "maxLength": 10485760 }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "packageId", "dossierId", "documents"],
      "properties": {
        "schemaVersion": { "const": "canonical.audit-package/v1" },
        "packageId": { "$ref": "#/$defs/digest" },
        "dossierId": { "$ref": "#/$defs/digest" },
        "documents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/metadata" }
        }
      }
    }
  }
}
