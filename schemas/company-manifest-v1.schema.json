{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical.plus/schemas/company-manifest-v1.schema.json",
  "title": "Canonical whole-company audit manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "scopeId", "companyName", "frameworks", "assessmentPeriod", "scope"],
  "properties": {
    "schemaVersion": { "const": "canonical.company-audit/v1" },
    "tenantId": { "$ref": "#/$defs/identifier" },
    "scopeId": { "$ref": "#/$defs/scopeId" },
    "companyName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "assessmentPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startsAt", "endsAt"],
      "properties": {
        "startsAt": { "type": "integer", "minimum": 0 },
        "endsAt": { "type": "integer", "minimum": 0 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "businessUnits": { "$ref": "#/$defs/textList" },
        "systems": { "$ref": "#/$defs/textList" },
        "dataClasses": { "$ref": "#/$defs/textList" },
        "vendors": { "$ref": "#/$defs/textList" },
        "jurisdictions": { "$ref": "#/$defs/textList" },
        "owners": { "$ref": "#/$defs/textList" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:@-]+$"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9._:@-]+(?:/[A-Za-z0-9._:@-]+)*$"
    },
    "textList": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    }
  }
}
