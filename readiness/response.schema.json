{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical-cloud.github.io/schemas/readiness-response-v1.schema.json",
  "title": "Canonical independent readiness response",
  "description": "Customer self-declarations only. TypeSpec and this JSON Schema are independently authored peer authorities checked with ORESoftware/typespec-json-schema-validator. Runtime semantic validation additionally enforces selected-framework question membership, exact expected context, unique known question IDs, Gregorian dates, and date ordering. Missing answers are unanswered, not inherited.",
  "$ref": "ReadinessResponse",
  "$defs": {
    "Identifier": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "Identifier",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "DateString": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "DateString",
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "FrameworkId": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "FrameworkId",
      "type": "string",
      "enum": ["soc2", "nist-csf2", "iso27001", "gdpr", "hipaa", "pci-dss", "cis-controls", "csa-ccm", "iso27701", "iso42001", "nist-80053", "nist-800171", "nis2", "dora", "fedramp-rev5"]
    },
    "ReadinessStatus": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ReadinessStatus",
      "type": "string",
      "enum": ["unanswered", "implemented", "partial", "missing", "not_applicable"]
    },
    "ReadinessContext": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ReadinessContext",
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["customerId", "assessmentId", "scope", "periodStart", "periodEnd", "asOf"],
      "properties": {
        "customerId": {"$ref": "Identifier"},
        "assessmentId": {"$ref": "Identifier"},
        "scope": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$"},
        "periodStart": {"$ref": "DateString"},
        "periodEnd": {"$ref": "DateString"},
        "asOf": {"$ref": "DateString"}
      }
    },
    "ReadinessAnswer": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ReadinessAnswer",
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["questionId", "status", "owner", "notes", "evidenceRef", "evidenceDate", "reviewer", "dueDate"],
      "properties": {
        "questionId": {"type": "string", "pattern": "^[a-z0-9-]+\\.q[0-9]{2}$"},
        "status": {"$ref": "ReadinessStatus"},
        "owner": {"type": "string", "maxLength": 128, "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$"},
        "notes": {"type": "string", "maxLength": 4000, "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$"},
        "evidenceRef": {"anyOf": [{"const": ""}, {"type": "string", "$ref": "Identifier"}]},
        "evidenceDate": {"anyOf": [{"const": ""}, {"type": "string", "$ref": "DateString"}]},
        "reviewer": {"type": "string", "maxLength": 128, "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$"},
        "dueDate": {"anyOf": [{"const": ""}, {"type": "string", "$ref": "DateString"}]}
      }
    },
    "ReadinessResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ReadinessResponse",
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["schemaVersion", "catalogVersion", "frameworkId", "context", "answers"],
      "properties": {
        "schemaVersion": {"type": "string", "const": "canonical.readiness-response/v1"},
        "catalogVersion": {"type": "string", "const": "2026-09-07.1"},
        "frameworkId": {"$ref": "FrameworkId"},
        "context": {"$ref": "ReadinessContext"},
        "answers": {"type": "array", "maxItems": 256, "items": {"$ref": "ReadinessAnswer"}}
      }
    }
  }
}
