{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical-cloud.github.io/schemas/readiness-response-v1.schema.json",
  "title": "Canonical independent readiness response",
  "description": "Customer self-declarations only. Runtime semantic validation additionally enforces the selected framework, catalog revision, exact expected context, unique known question IDs and date order. Missing answers are unanswered, not inherited.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "frameworkId", "context", "answers"],
  "properties": {
    "schemaVersion": {"const": "canonical.readiness-response/v1"},
    "catalogVersion": {"const": "2026-09-07.1"},
    "frameworkId": {"enum": ["soc2", "nist-csf2", "iso27001", "gdpr", "hipaa", "pci-dss", "cis-controls", "csa-ccm", "iso27701", "iso42001", "nist-80053", "nist-800171", "nis2", "dora", "fedramp-rev5"]},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["customerId", "assessmentId", "scope", "periodStart", "periodEnd", "asOf"],
      "properties": {
        "customerId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "assessmentId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "scope": {"type": "string", "maxLength": 1000, "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$", "minLength": 1},
        "periodStart": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "periodEnd": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "asOf": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "answers": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["questionId", "status", "owner", "notes", "evidenceRef", "evidenceDate", "reviewer", "dueDate"],
        "properties": {
          "questionId": {"type": "string", "pattern": "^[a-z0-9-]+\\.q[0-9]{2}$"},
          "status": {"enum": ["unanswered", "implemented", "partial", "missing", "not_applicable"]},
          "owner": {"type": "string", "maxLength": 128, "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$"},
          "notes": {"type": "string", "maxLength": 4000, "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$"},
          "reviewer": {"type": "string", "maxLength": 128, "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$"},
          "evidenceRef": {"anyOf": [{"const": ""}, {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}]},
          "evidenceDate": {"anyOf": [{"const": ""}, {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}]},
          "dueDate": {"anyOf": [{"const": ""}, {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}]}
        }
      }
    }
  }
}
